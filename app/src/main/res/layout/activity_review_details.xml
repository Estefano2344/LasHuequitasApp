<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/detail_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".view.ReviewDetailsActivity">

    <!-- Barra superior -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/barra_sup_inf"
        android:paddingStart="16dp"
        android:paddingTop="24dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/flecha_atras"
                android:contentDescription="@string/back_button"/>

            <TextView
                android:id="@+id/tvToolbarTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/plus_jakarta_sans"
                android:gravity="center"
                android:text="@string/review_title"
                android:textColor="@color/black"
                android:textSize="22sp"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>

    <!-- ProgressBar para carga -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Contenido desplazable -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigationView">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <!-- Información del restaurante -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tvRestaurantName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:text="Nombre del Restaurante"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <androidx.appcompat.widget.AppCompatRatingBar
                    android:id="@+id/ratingBarDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:numStars="5"
                    android:stepSize="0.1"
                    android:rating="5"
                    android:isIndicator="true"
                    style="?attr/ratingBarStyleIndicator"
                    android:progressTint="@color/orange_buttons_filledStars"
                    android:secondaryProgressTint="@color/orange_ratingRestaurantTransparent"
                    android:progressTintMode="src_in"
                    android:scaleX="0.8"
                    android:scaleY="0.8"/>
            </LinearLayout>

            <!-- Tags del restaurante -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tvTipoComidaDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:padding="6dp"
                    android:text="Italiana"
                    android:textColor="@color/brown_textFillFields_percentRating"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvRangoPrecioDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:padding="6dp"
                    android:text="$$"
                    android:textColor="@color/brown_textFillFields_percentRating"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvUbicacionDetail"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Centro"
                    android:textSize="12sp"
                    android:textColor="@color/brown_reviewsDescription_textIcons_profileDetails"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:gravity="end"
                    android:layout_gravity="center_vertical"/>
            </LinearLayout>

            <!-- Imagen principal de la reseña -->
            <ImageView
                android:id="@+id/ivReviewImage"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginBottom="16dp"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/review_ham_photo" />

            <!-- Título de la reseña -->
            <TextView
                android:id="@+id/tvReviewTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="@string/title_review"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <!-- Fecha de la reseña -->
            <TextView
                android:id="@+id/tvReviewDateDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="Hace 2 días"
                android:textColor="@color/brown_reviewsDescription_textIcons_profileDetails"
                android:textSize="14sp"/>

            <!-- Descripción de la reseña -->
            <TextView
                android:id="@+id/tvReviewDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="@string/desc_review"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"/>

            <!-- Sección Comentarios -->
            <TextView
                android:id="@+id/tvCommentsTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="@string/comments"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <!-- Contenedor dinámico para comentarios -->
            <LinearLayout
                android:id="@+id/comentariosContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp"/>

            <!-- Mensaje cuando no hay comentarios -->
            <TextView
                android:id="@+id/tvNoComments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="No hay comentarios aún. ¡Sé el primero en comentar!"
                android:textColor="@color/brown_reviewsDescription_textIcons_profileDetails"
                android:textSize="14sp"
                android:textStyle="italic"
                android:gravity="center"
                android:visibility="gone"/>

            <!-- ProgressBar para comentarios -->
            <ProgressBar
                android:id="@+id/progressBarComments"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="16dp"
                android:visibility="gone"/>

            <!-- Botón + texto "Agregar Comentario" -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginTop="24dp">

                <ImageButton
                    android:id="@+id/btnAddComment"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_circle"
                    android:src="@drawable/comentario"
                    android:contentDescription="@string/add_comment"
                    app:tint="@color/brown_icons"
                    android:padding="12dp"
                    android:scaleType="centerInside"/>

                <TextView
                    android:id="@+id/tvAddComment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:text="@string/add_comment"
                    android:textColor="@color/black"
                    android:textSize="14sp"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Barra de navegación inferior -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/barra_sup_inf"
        app:itemIconTint="@color/brown_icons"
        app:itemTextAppearanceActive="@style/BottomNavText"
        app:itemTextAppearanceInactive="@style/BottomNavText"
        app:itemTextColor="@color/brown_reviewsDescription_textIcons_profileDetails"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>